{
  "rewrites": [
    {
      "source": "/api/alerts",
      "destination": "https://fib-trading-bot.onrender.com/api/alerts"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
